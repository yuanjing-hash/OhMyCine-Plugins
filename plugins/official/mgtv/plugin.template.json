{
  "schemaVersion": 1,
  "id": "org.ohmycine.mgtv",
  "name": "芒果 TV",
  "description": "使用管理员芒果账号浏览官方点播目录、验证具体视频权益并播放；只读媒体库。",
  "version": "0.1.0",
  "apiVersion": "1",
  "minServerVersion": "0.1.1",
  "runtime": "wasm",
  "entry": "plugin.wasm",
  "capabilities": [
    "site.auth",
    "site.navigation",
    "site.feed",
    "site.search",
    "site.detail",
    "media.playback",
    "media.quality_switch",
    "media.subtitle",
    "media.offline_download_plan",
    "media.metadata",
    "library.artwork_candidates"
  ],
  "navigationMode": "hierarchical",
  "permissions": [
    {
      "kind": "network.http",
      "domains": [
        "pianku.api.mgtv.com",
        "pcweb.api.mgtv.com",
        "pcweb1.api.mgtv.com",
        "pcweb2.api.mgtv.com",
        "pcweb3.api.mgtv.com",
        "nuc.api.mgtv.com",
        "i.mgtv.com",
        "oauth.mgtv.com",
        "www.mgtv.com",
        "so.mgtv.com",
        "mobileso.bz.mgtv.com",
        "0img.hitv.com",
        "1img.hitv.com",
        "2img.hitv.com",
        "3img.hitv.com",
        "4img.hitv.com",
        "web-disp.titan.mgtv.com",
        "web-disp1.titan.mgtv.com",
        "web-disp2.titan.mgtv.com",
        "pcvideoks.titan.mgtv.com",
        "mobile-stream.api.mgtv.com",
        "pcvideomigu.titan.mgtv.com"
      ]
    },
    {
      "kind": "credential.use",
      "scopes": [
        "mgtv.session"
      ]
    },
    {
      "kind": "storage.private",
      "maxBytes": 8388608
    },
    {
      "kind": "download.plan"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "settingsPage": {
    "version": 1,
    "tabs": [
      {
        "id": "account",
        "title": "账号",
        "sections": [
          {
            "id": "login",
            "title": "管理员芒果账号",
            "description": "使用芒果 TV 手机客户端扫码。账号凭据由 Server 加密保存，获授权的用户共用。",
            "fields": [
              {
                "type": "credential-status",
                "label": "账号及会员状态"
              },
              {
                "type": "notice",
                "label": "只读点播媒体库",
                "description": "目录采用芒果官方分类。每次播放重新检查具体视频和清晰度权益；不会购买、用券或修改账号收藏和观看记录。"
              },
              {
                "type": "notice",
                "label": "本地下载权益",
                "description": "下载当前账号已获完整播放权益且官方开放下载入口的视频；具体清晰度再次校验，试看和 DRM 视频拒绝下载。"
              }
            ]
          }
        ]
      }
    ]
  },
  "author": "OhMyCine",
  "license": "MIT",
  "homepage": "https://github.com/yuanjing-hash/OhMyCine-Plugins/tree/main/plugins/official/mgtv",
  "source": "https://github.com/yuanjing-hash/OhMyCine-Plugins",
  "packageSha256": "${PACKAGE_SHA256}"
}
