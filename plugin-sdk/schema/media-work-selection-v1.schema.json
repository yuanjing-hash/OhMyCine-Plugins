{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohmycine.dev/schemas/media-work-selection-v1.schema.json",
  "title": "Runtime v1 MediaWork default-selection extension",
  "description": "Validates the additive default selection fields, not the complete MediaWork. Consumers must also verify exact membership of defaultSegmentId in segments.",
  "type": "object",
  "properties": {
    "defaultSegmentId": { "$ref": "#/$defs/id" },
    "segments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "$ref": "#/$defs/id" } }
      }
    }
  },
  "if": {
    "properties": { "defaultSegmentId": {} },
    "required": ["defaultSegmentId"]
  },
  "then": {
    "required": ["segments"],
    "properties": { "segments": { "type": "array", "minItems": 1 } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
